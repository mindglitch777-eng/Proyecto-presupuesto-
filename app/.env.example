# Copiá este archivo a .env.local para probar en tu compu. En Netlify se cargan en
# Project configuration → Environment variables. Nunca subas claves al repositorio.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública ("publishable", empieza con sb_publishable_). Es la del navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta ("secret", empieza con sb_secret_). Solo servidor: nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública de la web (para el link que ve WhatsApp). En Netlify se completa sola con la variable URL.
APP_URL=

# WhatsApp de contacto, solo números con código de país. Ej.: 5493756123456
NEXT_PUBLIC_WHATSAPP=
