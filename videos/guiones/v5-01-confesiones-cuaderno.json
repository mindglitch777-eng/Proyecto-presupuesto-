 "lineas": [
  {
   "desde": 0.0,
   "hasta": 2.6,
   "texto": "GANCHO",
   "gigante": true,
   "gancho": true
  },
  {
   "desde": 2.9,
   "hasta": 6.2,
   "texto": "Hace once años vivo acá. Hoy te digo quién fundió a mi dueño.",
   "antes": 0.3
  },
  {
   "desde": 6.5,
   "hasta": 10.4,
   "texto": "Doña Marta: dieciocho mil. Juan: siete quinientos. El de la moto: sin nombre.",
   "antes": 0.3
  },
  {
   "desde": 10.7,
   "hasta": 13.6,
   "texto": "Ciento ochenta mil… que él cree que va a cobrar.",
   "antes": 0.3
  },
  {
   "desde": 13.9,
   "hasta": 15.3,
   "texto": "Pero eso no es lo peor.",
   "antes": 0.3,
   "estilo": {
    "rate": "+15%",
    "pitch": "-7Hz"
   }
  },
  {
   "desde": 15.7,
   "hasta": 20.0,
   "texto": "Lo peor es lo que no anoto: el aumento, lo vencido, la ganancia.",
   "antes": 0.35
  },
  {
   "desde": 20.4,
   "hasta": 22.0,
   "texto": "¿Querés saber quién lo fundió?",
   "antes": 0.3,
   "estilo": {
    "rate": "+15%",
    "pitch": "-7Hz"
   }
  },
  {
   "desde": 22.6,
   "hasta": 23.3,
   "texto": "Fui yo.",
   "gigante": true,
   "antes": 0.6,
   "estilo": {
    "rate": "+0%",
    "pitch": "-9Hz",
    "volume": "+10%"
   }
  },
  {
   "desde": 23.8,
   "hasta": 27.5,
   "texto": "Ahora le habla al celular y en cinco minutos sabe todo.",
   "antes": 0.4
  },
  {
   "desde": 27.9,
   "hasta": 32.5,
   "texto": "Me jubiló, y me lo merecía. ¿Cuántos años tiene tu cuaderno? Comentalo.",
   "antes": 0.3
  }
 ],
