 "lineas": [
  {
   "desde": 0.0,
   "hasta": 3.1,
   "texto": "GANCHO",
   "gigante": true,
   "gancho": true
  },
  {
   "desde": 3.4,
   "hasta": 8.2,
   "texto": "Prestás leche, pan, cigarrillos. Sin firma, sin interés, sin fecha."
  },
  {
   "desde": 8.6,
   "hasta": 12.6,
   "texto": "Un banco te cobra intereses. Vos, cero."
  },
  {
   "desde": 13.4,
   "hasta": 15.6,
   "texto": "Y encima, nadie te paga.",
   "gigante": true
  },
  {
   "desde": 17.4,
   "hasta": 23.4,
   "texto": "En Claro te dice quién te debe, desde cuándo, y le avisa el día que cobra."
  },
  {
   "desde": 24.2,
   "hasta": 26.8,
   "texto": "Cobrá como un banco. Probalo gratis.",
   "gigante": true,
   "gancho": true
  }
