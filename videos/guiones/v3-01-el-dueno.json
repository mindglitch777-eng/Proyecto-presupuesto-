  },
  {
   "desde": 3.0,
   "hasta": 7.9,
   "texto": "Vendés tres millones. Alquiler: cuatrocientos mil. A vos te quedan trescientos cincuenta mil.",
   "subtitulo": "Vendés $3.000.000. Alquiler: $400.000. A vos te quedan $350.000."
  },
  {
   "desde": 8.2,
   "hasta": 12.6,
   "texto": "Él no abre a las ocho. No atiende. No fía.",
   "subtitulo": "Él no abre a las 8. No atiende. No fía."
  },
  {
   "desde": 13.2,
   "hasta": 15.6,
   "texto": "Y vos ni sabías esta cuenta.",
   "gigante": true
  },
  {
   "desde": 17.2,
   "hasta": 23.6,
   "texto": "En Claro te la hace todos los días y te dice dónde se va tu plata."
  },
  {
   "desde": 24.6,
   "hasta": 27.4,
   "texto": "Probalo gratis.",
   "gigante": true,
   "gancho": true
  }
