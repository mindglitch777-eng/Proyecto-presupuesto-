 ],
 "lineas": [
  {
   "desde": 0,
   "hasta": 2.4,
   "texto": "GANCHO",
   "gigante": true,
   "gancho": true
  },
  {
   "desde": 2.7,
   "hasta": 4.9,
   "texto": "Cierran hasta setenta kioscos por día. ¿El tuyo es el próximo?",
   "subtitulo": "Cierran hasta 70 kioscos por día. ¿El tuyo es el próximo?"
  },
  {
   "desde": 5.1,
   "hasta": 9.3,
   "texto": "Vendés tres millones. Mercadería, alquiler, luz… te quedan trescientos cincuenta mil.",
   "subtitulo": "Vendés 3 millones. Mercadería, alquiler, luz… te quedan $350.000."
  },
  {
   "desde": 9.6,
   "hasta": 11.8,
   "texto": "Catorce horas por día. Ochocientos treinta y tres pesos la hora.",
   "subtitulo": "14 horas por día. $833 la hora."
  },
  {
   "desde": 12.1,
   "hasta": 13.8,
   "texto": "Y tu cuaderno nunca te lo dijo.",
   "gigante": true
  },
  {
   "desde": 14.2,
   "hasta": 15.3,
   "texto": "Esto sí.",
   "gigante": true,
   "gancho": true
  },
  {
   "desde": 16.0,
   "hasta": 19.2,
   "texto": "Le hablás… y te hace la cuenta."
  },
  {
   "desde": 19.6,
   "hasta": 22.8,
   "texto": "Te dice a quién cobrarle, a cuánto vender y qué no reponer."
  },
  {
   "desde": 23.2,
   "hasta": 25.9,
   "texto": "Una foto a la factura, y los carteles listos."
  },
  {
   "desde": 26.4,
   "hasta": 29.2,
   "texto": "Cuatrocientos treinta pesos por día. Menos que un alfajor.",
   "subtitulo": "$430 por día. Menos que un alfajor."
  },
  {
   "desde": 29.8,
   "hasta": 31.6,
   "texto": "En Claro. Dejá de adivinar.",
   "gigante": true,
   "gancho": true
  }
 ],
